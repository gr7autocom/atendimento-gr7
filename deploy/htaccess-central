# Vai para `dist/atendimento/.htaccess` no build, e daí para o document root de
# atendimento.gr7autocom.com.br.
#
# Esta pasta contém SÓ a central da equipe. Não há manifesto de PWA nem service
# worker aqui, e é por isso que o navegador nunca oferece instalar a central
# (ADR-11) — não é regra de servidor, é o arquivo não existir.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Arquivo ou pasta que existe é entregue como está (JavaScript, CSS, fontes,
  # logo). Precisa vir antes da regra de baixo, senão ela engole tudo e a
  # aplicação nunca carrega o próprio código.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # O resto é rota do navegador (react-router): /inbox, /admin/... todas caem
  # no mesmo HTML, que decide o que mostrar.
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Arquivo gerado pelo Vite tem hash no nome (`central-a1b2c3d4.js`), então o
  # conteúdo daquele nome nunca muda e pode ficar guardado para sempre.
  <FilesMatch "-[A-Za-z0-9_]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # O HTML tem nome fixo: guardado, prenderia todo mundo na versão antiga.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
