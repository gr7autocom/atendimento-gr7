# Secrets das Edge Functions do WhatsApp (uazapi).
# Copiar para supabase/functions/.env, preencher e aplicar com:
#   supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
# NUNCA commitar valores reais (o .env já está no .gitignore). Ver docs/whatsapp.md.

UAZAPI_BASE_URL=
UAZAPI_TOKEN=
UAZAPI_ADMIN_TOKEN=

# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetados automaticamente no runtime
# das Edge Functions — não precisam ser definidos aqui.
